{
  "name": "dsh-whale-companion",
  "version": "1.0.0",
  "description": "A native DSH desktop whale with growth, achievements, skins, and privacy-safe progress tracking",
  "type": "module",
  "main": "./packages/dsh-whale-companion/lib/index.js",
  "types": "./packages/dsh-whale-companion/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/dsh-whale-companion/lib/index.d.ts",
      "default": "./packages/dsh-whale-companion/lib/index.js"
    },
    "./client": {
      "types": "./packages/dsh-whale-companion/lib/client.d.ts",
      "default": "./packages/dsh-whale-companion/lib/client.js"
    },
    "./typert": {
      "types": "./packages/dsh-whale-companion/lib/typert.host.d.ts",
      "default": "./packages/dsh-whale-companion/lib/typert.host.js"
    },
    "./remote": {
      "types": "./packages/dsh-whale-companion/lib/typert.remote-client.d.ts",
      "default": "./packages/dsh-whale-companion/lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./packages/dsh-whale-companion/lib/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/dsh-whale-companion/lib/*.js",
    "packages/dsh-whale-companion/lib/*.d.ts",
    "packages/dsh-whale-companion/lib/*.js.map",
    "packages/dsh-whale-companion/lib/*.d.ts.map",
    "packages/dsh-whale-companion/assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "corepack pnpm run build:host && corepack pnpm run build:client",
    "build:host": "corepack pnpm --dir packages/dsh-whale-companion run build:host",
    "build:client": "corepack pnpm --dir packages/dsh-whale-companion run build:client",
    "clean": "corepack pnpm --dir packages/dsh-whale-companion run clean",
    "typecheck": "corepack pnpm --dir packages/dsh-whale-companion run typecheck",
    "test": "vitest run",
    "pack:check": "node scripts/verify-package.mjs && npm pack --dry-run",
    "prepack": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeemanCheung/dsh-whale-companion.git"
  },
  "bugs": {
    "url": "https://github.com/LeemanCheung/dsh-whale-companion/issues"
  },
  "homepage": "https://github.com/LeemanCheung/dsh-whale-companion#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
